{
  "manifest_version": 3,
  "name": "Nova Nest",
  "version": "0.2.6",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.zillow.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.zillow.com/*"
      ],
      "js": [
        "dom-fields.js",
        "capture-requests.js",
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": "",
  "icons": {
    "16": "icons/nova-16.png",
    "32": "icons/nova-32.png",
    "48": "icons/nova-48.png",
    "128": "icons/nova-128.png"
  },
  "action": {
    "default_title": "Nova Nest",
    "default_icon": {
      "16": "icons/nova-16.png",
      "32": "icons/nova-32.png",
      "48": "icons/nova-48.png",
      "128": "icons/nova-128.png"
    }
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/nova-32.png"
      ],
      "matches": [
        "https://www.zillow.com/*"
      ]
    }
  ]
}

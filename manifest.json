{
  "manifest_version": 3,
  "name": "Zillow Observations",
  "version": "0.1.4",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://www.zillow.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.zillow.com/*"
      ],
      "js": [
        "extract.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "key": ""
}
